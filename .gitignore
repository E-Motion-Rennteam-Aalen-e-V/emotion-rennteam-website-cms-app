# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# CMS: lokal angelegte Zusatz-Benutzer (Passwort-Hashes, nie versionieren)
/.cms-users.json

# CMS: Laufzeit-Status des Auto-Update-Supervisors (scripts/cms-supervisor.mjs)
/.cms-update-status.json
/.cms-update-trigger

# Formulare: lokaler Fallback, falls FORM_WEBHOOK_URL fehlt oder unerreichbar ist
/.pending-form-submissions.jsonl

# tinacms
/tina/__generated__
/public/admin
AGENTS.md
CLAUDE.md

# claude code
/.claude/
